# Server-only Vercel environment variables. Never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional server overrides. The checked-in defaults match the production Firebase project.
FIREBASE_PROJECT_ID=adepec-scanner-invites
FIREBASE_WEB_API_KEY=

# Optional client setting (Vercel env, VITE_ prefix is intended): Google Sheet id of the per-house template.
# New projects get a copy of it in their lot folder. Leave empty to link an existing Sheet instead.
VITE_TEMPLATE_SHEET_ID=
