rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function hasAccess() {
      return signedIn()
        && (isAdmin() || exists(/databases/$(database)/documents/user_access/$(request.auth.uid)));
    }

    match /admins/{email} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    match /user_access/{uid} {
      allow get: if signedIn() && (isAdmin() || request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'sourceInviteId', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.sourceInviteId)).data.claimedByUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /invites/CONFIG-GEMINI {
      allow read, write: if false;
    }

    match /invites/{code} {
      allow get: if signedIn()
        && code != 'CONFIG-GEMINI'
        && (isAdmin() || resource.data.used == false || resource.data.claimedByUid == request.auth.uid);
      allow list: if isAdmin()
        || (signedIn() && code != 'CONFIG-GEMINI' && resource.data.claimedByUid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && code != 'CONFIG-GEMINI'
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.claimedByUid == request.auth.uid
          && request.resource.data.claimedByEmail == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'used',
            'usedAt',
            'claimedByUid',
            'claimedByEmail'
          ])
        );
    }

    function isProjectAuthorized(projectData) {
      return request.auth.uid == projectData.ownerUid
        || (projectData.memberUids != null && request.auth.uid in projectData.memberUids);
    }

    match /projects/{projectId} {
      allow get: if hasAccess() && isProjectAuthorized(resource.data);
      allow list: if hasAccess() && (
        resource.data.ownerUid == request.auth.uid
        || (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
      );
      allow create: if hasAccess()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == projectId;
      allow update: if hasAccess()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if hasAccess() && resource.data.ownerUid == request.auth.uid;
    }

    match /project_invites/{inviteId} {
      allow get, list: if hasAccess() && (
        resource.data.invitedEmail == request.auth.token.email
        || resource.data.invitedByUid == request.auth.uid
      );
      allow create: if hasAccess()
        && request.resource.data.invitedByUid == request.auth.uid
        && request.auth.uid == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerUid;
      allow update, delete: if hasAccess() && resource.data.invitedByUid == request.auth.uid;
    }

  }
}
